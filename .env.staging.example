# ==============================================================================
# CampusVote - Staging Environment Configuration Template
# COPY THIS FILE TO .env IN YOUR STAGING ENVIRONMENT.
# NEVER COMMIT COMPLETED SECRETS OR SENSITIVE PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core & Security Settings
# ------------------------------------------------------------------------------
# Generate a cryptographically secure 64+ char key: python -c 'import secrets; print(secrets.token_urlsafe(64))'
# Server startup will abort immediately if default development key is detected when DEBUG=False.
DJANGO_SECRET_KEY=generate_cryptographically_secure_random_key_for_staging_minimum_64_chars
DJANGO_DEBUG=False
ENVIRONMENT=staging
API_VERSION=v1

# Comma-separated domains/IPs permitted to serve the application
DJANGO_ALLOWED_HOSTS=staging.campusvote.institution.edu,staging-api.campusvote.institution.edu,127.0.0.1,localhost

# ------------------------------------------------------------------------------
# Database Settings (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Standard PostgreSQL parameters
DB_ENGINE=postgresql
DB_NAME=campusvote_staging
DB_USER=campusvote_staging_user
DB_PASSWORD=replace_with_strong_unique_database_password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Optional single-URI connection string (takes precedence over discrete DB_* if set)
# DATABASE_URL=postgresql://campusvote_staging_user:password@127.0.0.1:5432/campusvote_staging

# ------------------------------------------------------------------------------
# Django Channels & Redis Configuration (Redis 7.2+)
# ------------------------------------------------------------------------------
# Set to channels_redis.core.RedisChannelLayer to enable multi-worker ASGI WebSocket broadcast
CHANNEL_LAYER_BACKEND=channels_redis.core.RedisChannelLayer
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional Redis connection string
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# Privacy threshold: Minimum cohort size required before departmental counts are disclosed in live monitoring
MONITORING_PRIVACY_SUPPRESSION_THRESHOLD=5

# ------------------------------------------------------------------------------
# CORS, CSRF & Content Security Policy (HTTPS Required)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://staging.campusvote.institution.edu
CSRF_TRUSTED_ORIGINS=https://staging.campusvote.institution.edu
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Optional additional connect-src origins for Content Security Policy if API is hosted on separate domain
CSP_EXTRA_CONNECT_SRC=https://staging-api.campusvote.institution.edu wss://staging-api.campusvote.institution.edu

# ------------------------------------------------------------------------------
# Identity Verification & Notification Delivery (Phase 4)
# ------------------------------------------------------------------------------
VERIFICATION_OTP_LENGTH=6
VERIFICATION_OTP_EXPIRY_SECONDS=300
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_MAX_RESENDS=3
VERIFICATION_LOCKOUT_MINUTES=15
VERIFICATION_GENERIC_ERRORS=True

# Delivery Provider: Set to 'email' for staging SMTP or 'mock' for isolated internal testing
VERIFICATION_DELIVERY_PROVIDER=email

# Institutional SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.institution.edu
EMAIL_PORT=587
EMAIL_HOST_USER=campusvote-notifications@institution.edu
EMAIL_HOST_PASSWORD=replace_with_institutional_smtp_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL="CampusVote Election Authority" <campusvote-notifications@institution.edu>

# Institutional SMS Gateway Configuration (if SMS verification is enabled)
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=CAMPUSVOTE

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# CRITICAL NON-NEGOTIABLE SAFETY RESTRICTIONS
# DO NOT ALTER. REAL ELECTIONS REQUIRE FORMAL INDEPENDENT SECURITY AUDIT.
# ------------------------------------------------------------------------------
# Live voting remains fail-closed blocked. Real voter tallies cannot be published without certification.
FAIL_CLOSED_VOTING_RESTRICTION_ACTIVE=True
INDEPENDENT_VOTING_SECURITY_REVIEW_APPROVED=False
