# ==============================================================================
# CampusVote Frontend Environment Configuration (Vite)
# ==============================================================================

# Base URL for Backend REST API
# Leave blank when frontend is served from the same domain or behind an NGINX reverse proxy.
# Set explicitly when deploying frontend and backend to distinct origins in staging.
# Example: https://staging-api.institution.edu
VITE_API_BASE_URL=

# Base URL for WebSocket Turnout Telemetry
# Leave blank when using the default relative origin (wss://host or ws://host).
# Example: wss://staging-api.institution.edu
VITE_WS_BASE_URL=

# Development Proxy Target (used by Vite dev/preview server)
# In local development, defaults to http://127.0.0.1:8000
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_BACKEND_WS_URL=http://127.0.0.1:8000
