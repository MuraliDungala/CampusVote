# ==============================================================================
# Smart ID-Based College Voting System - Environment Configuration
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT. DO NOT COMMIT .env TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-campusvote-development-secret-key-12345
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ------------------------------------------------------------------------------
# Database Settings
# Set DB_ENGINE=sqlite for local development without Docker/PostgreSQL.
# Set DB_ENGINE=postgresql when running with PostgreSQL (Docker or local instance).
# ------------------------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=campusvote_db
DB_USER=campusvote_user
DB_PASSWORD=replace_with_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432

# ------------------------------------------------------------------------------
# Redis Settings (Used for Django Channels and Celery)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# CORS & Security Settings
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
API_VERSION=v1

# ------------------------------------------------------------------------------
# Phase 4 Identity Verification & OTP Settings
# ------------------------------------------------------------------------------
VERIFICATION_OTP_LENGTH=6
VERIFICATION_OTP_EXPIRY_SECONDS=300
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_MAX_RESENDS=3
VERIFICATION_LOCKOUT_MINUTES=15
VERIFICATION_DELIVERY_PROVIDER=mock
VERIFICATION_GENERIC_ERRORS=False
DEFAULT_FROM_EMAIL=noreply@campusvote.local
EMAIL_HOST=smtp.institution.edu
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=
